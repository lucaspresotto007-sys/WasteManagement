# =============================================================================
# Waste Management ESG API — Environment Variables Template
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in the values below
# 3. NEVER commit the .env file to git
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Password for the SQL Server SA user. Must be strong (uppercase, number, symbol).
SA_PASSWORD=Your_Password123#

# Name of the database to create/use inside SQL Server
DB_NAME=WasteManagementDb

# Host port that SQL Server will be exposed on (default: 1433)
DB_PORT=1433

# ─── API ─────────────────────────────────────────────────────────────────────
# Host port that the Web API will be exposed on (default: 5000)
API_PORT=5000

# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Use a long random string in production.
JWT_KEY=WasteManagementAPI_Secret_Security_Key_2026_FIAP

JWT_ISSUER=WasteManagementAPI
JWT_AUDIENCE=WasteManagementAPI
